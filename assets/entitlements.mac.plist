<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required by Electron's V8 JIT under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- node-pty, nut-js, node-window-manager ship native addons that are not
         signed with our team ID. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Voice input. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- AppleScript / System Events for closing windows and quitting apps. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
